generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  companyType String
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?

  isActive   Boolean   @default(true)
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects        Project[]
  workers         Worker[]
  contractors     Contractor[]
  planningRecords PlanningRecord[]

  @@index([tenantId])
  @@index([isArchived])
}

model Project {
  id        String @id @default(cuid())
  tenantId  String
  companyId String

  name        String
  projectCode String?
  clientName  String?
  projectType String?
  description String?

  address  String?
  city     String?
  state    String?
  zipCode  String?
  location String?

  status String @default("Planning")

  startDate DateTime?
  endDate   DateTime?

  projectManager String?
  superintendent String?
  safetyManager  String?

  contractValue     Decimal? @db.Decimal(14, 2)
  plannedWorkforce  Int      @default(0)
  currentWorkforce  Int      @default(0)
  workersOnsite     Int      @default(0)
  activeContractors Int      @default(0)
  totalManHours     Int      @default(0)

  progress                 Int @default(0)
  openActions              Int @default(0)
  recordableIncidents      Int @default(0)
  permitsOpen              Int @default(0)
  planningDocumentsPending Int @default(0)
  trainingCompliance       Int @default(100)
  accessCompliance         Int @default(100)
  healthScore              Int @default(100)

  isActive   Boolean   @default(true)
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                        Company                         @relation(fields: [companyId], references: [id])
  workers                        Worker[]
  contractors                    Contractor[]
  contractorDocuments            ContractorDocument[]
  contractorDocumentRequirements ContractorDocumentRequirement[]
  planningRecords                PlanningRecord[]

  @@index([tenantId])
  @@index([companyId])
  @@index([isArchived])
  @@index([status])
}

model Worker {
  id       String @id @default(cuid())
  tenantId String

  companyId String
  projectId String?

  firstName  String
  middleName String?
  lastName   String
  suffix     String?

  employeeNumber String?
  email          String?
  phone          String?

  trade      String?
  jobTitle   String?
  crew       String?
  foreman    String?
  unionLocal String?

  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  orientationStatus    String    @default("Not Started")
  orientationDate      DateTime?
  orientationExpiresAt DateTime?

  trainingStatus String @default("Pending")

  drugScreenStatus    String    @default("Not Required")
  drugScreenDate      DateTime?
  drugScreenExpiresAt DateTime?

  badgeNumber    String?
  badgeStatus    String    @default("Inactive")
  badgeExpiresAt DateTime?
  qrCredentialId String?   @unique

  accessStatus String @default("Pending")

  hireDate  DateTime?
  startDate DateTime?
  endDate   DateTime?

  isActive   Boolean   @default(true)
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  dailyWseSignatures DailyWorkerSafetyEngagementSignature[]

  @@index([tenantId])
  @@index([companyId])
  @@index([projectId])
  @@index([isArchived])
  @@index([accessStatus])
  @@index([badgeStatus])
  @@index([lastName, firstName])
}

model Contractor {
  id       String @id @default(cuid())
  tenantId String

  companyId String
  projectId String?

  name           String
  legalName      String?
  contractorCode String?

  trade       String?
  specialty   String?
  description String?

  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?

  safetyContactName  String?
  safetyContactEmail String?
  safetyContactPhone String?

  address String?
  city    String?
  state   String?
  zipCode String?

  workforceCount Int @default(0)

  emr  Decimal? @db.Decimal(5, 2)
  trir Decimal? @db.Decimal(6, 2)

  insuranceProvider  String?
  insuranceExpiresAt DateTime?

  orientationStatus String @default("Pending")
  complianceStatus  String @default("Pending")
  approvalStatus    String @default("Pending")

  isActive   Boolean   @default(true)
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company              @relation(fields: [companyId], references: [id])
  project         Project?             @relation(fields: [projectId], references: [id])
  documents       ContractorDocument[]
  planningRecords PlanningRecord[]

  @@index([tenantId])
  @@index([companyId])
  @@index([projectId])
  @@index([isArchived])
  @@index([approvalStatus])
  @@index([complianceStatus])
  @@index([name])
}

model ContractorDocument {
  id       String @id @default(cuid())
  tenantId String

  contractorId String
  projectId    String?

  documentType String
  documentName String

  fileName        String
  mimeType        String
  fileSize        Int
  storageProvider String
  storageKey      String
  storageUrl      String?

  effectiveDate  DateTime?
  expirationDate DateTime?

  approvalStatus String @default("Pending")
  reviewStatus   String @default("Not Reviewed")

  notes String?

  aiProcessingStatus String   @default("Not Started")
  aiDocumentType     String?
  aiConfidence       Decimal? @db.Decimal(5, 4)
  extractedData      Json?
  confirmedData      Json?

  uploadedBy String?
  reviewedBy String?
  reviewedAt DateTime?

  isActive   Boolean   @default(true)
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  events                  ContractorDocumentEvent[]
  planningSourceDocuments PlanningSourceDocument[]

  @@index([tenantId])
  @@index([contractorId])
  @@index([projectId])
  @@index([documentType])
  @@index([expirationDate])
  @@index([approvalStatus])
  @@index([reviewStatus])
  @@index([isArchived])
}

model ContractorDocumentRequirement {
  id       String @id @default(cuid())
  tenantId String

  projectId String

  documentType String
  name         String
  description  String?

  isRequired         Boolean @default(true)
  expirationRequired Boolean @default(false)
  reviewRequired     Boolean @default(true)

  sortOrder Int @default(0)

  isActive   Boolean   @default(true)
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, documentType])
  @@index([tenantId])
  @@index([projectId])
  @@index([documentType])
  @@index([isRequired])
  @@index([isArchived])
}

model ContractorDocumentEvent {
  id       String @id @default(cuid())
  tenantId String

  contractorDocumentId String
  contractorId         String

  eventType String

  previousApprovalStatus String?
  newApprovalStatus      String?

  previousReviewStatus String?
  newReviewStatus      String?

  comment     String?
  performedBy String?

  createdAt DateTime @default(now())

  contractorDocument ContractorDocument @relation(fields: [contractorDocumentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractorDocumentId])
  @@index([contractorId])
  @@index([eventType])
  @@index([createdAt])
}

model PlanningRecord {
  id       String @id @default(cuid())
  tenantId String

  companyId    String
  projectId    String
  contractorId String?

  planType String
  title    String

  status         String @default("Draft")
  revisionNumber Int    @default(1)

  responsibleSupervisor   String?
  responsibleSupervisorId String?

  plannedStartDate DateTime?
  workLocation     String?
  crewSize         Int?
  shift            String?

  scopeDescription   String?
  equipmentTools     String?
  materialsChemicals String?
  adjacentWork       String?
  specialConditions  String?

  requiredPpe      String?
  requiredPermits  String?
  emergencyPlan    String?
  stopWorkTriggers String?
  planningNotes    String?

  qualityScore Int @default(0)

  submittedAt DateTime?
  approvedAt  DateTime?
  activeAt    DateTime?

  isActive   Boolean   @default(true)
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  project    Project     @relation(fields: [projectId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  workSteps         PlanningWorkStep[]
  questionResponses PlanningQuestionResponse[]
  sourceDocuments   PlanningSourceDocument[]
  revisions         PlanningRevision[]
  reviews           PlanningReview[]
  reviewComments    PlanningReviewComment[]
  signatures        PlanningSignature[]
  events            PlanningEvent[]
  dailyWseRecords   DailyWorkerSafetyEngagement[]

  @@index([tenantId])
  @@index([companyId])
  @@index([projectId])
  @@index([contractorId])
  @@index([planType])
  @@index([status])
  @@index([revisionNumber])
  @@index([isArchived])
  @@index([createdAt])
}

model PlanningWorkStep {
  id       String @id @default(cuid())
  tenantId String

  planningRecordId String

  sequence    Int
  title       String
  description String?

  hazards  String?
  controls String?

  safetyCritical Boolean @default(false)
  riskLevel      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningRecord PlanningRecord @relation(fields: [planningRecordId], references: [id], onDelete: Cascade)

  @@unique([planningRecordId, sequence])
  @@index([tenantId])
  @@index([planningRecordId])
  @@index([riskLevel])
  @@index([safetyCritical])
}

model PlanningQuestionResponse {
  id       String @id @default(cuid())
  tenantId String

  planningRecordId String

  questionId String
  category   String
  question   String
  helpText   String?

  isCritical Boolean @default(false)

  responseValue String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningRecord PlanningRecord @relation(fields: [planningRecordId], references: [id], onDelete: Cascade)

  @@unique([planningRecordId, questionId])
  @@index([tenantId])
  @@index([planningRecordId])
  @@index([category])
  @@index([isCritical])
}

model PlanningSourceDocument {
  id       String @id @default(cuid())
  tenantId String

  planningRecordId     String
  contractorDocumentId String?

  sourceType String
  label      String?

  fileName        String?
  mimeType        String?
  fileSize        Int?
  storageProvider String?
  storageKey      String?
  storageUrl      String?

  isSelected Boolean @default(true)
  isAiReady  Boolean @default(false)

  approvalStatusAtSelection String?
  reviewStatusAtSelection   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningRecord     PlanningRecord      @relation(fields: [planningRecordId], references: [id], onDelete: Cascade)
  contractorDocument ContractorDocument? @relation(fields: [contractorDocumentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([planningRecordId])
  @@index([contractorDocumentId])
  @@index([sourceType])
  @@index([isSelected])
}

model PlanningRevision {
  id       String @id @default(cuid())
  tenantId String

  planningRecordId String
  revisionNumber   Int

  status String

  revisionReason String?
  snapshot       Json

  createdBy String?

  createdAt DateTime @default(now())

  planningRecord PlanningRecord @relation(fields: [planningRecordId], references: [id], onDelete: Cascade)

  @@unique([planningRecordId, revisionNumber])
  @@index([tenantId])
  @@index([planningRecordId])
  @@index([revisionNumber])
  @@index([createdAt])
}

model PlanningReview {
  id       String @id @default(cuid())
  tenantId String

  planningRecordId String
  revisionNumber   Int

  reviewerId   String?
  reviewerName String
  reviewerRole String

  status String @default("In Review")

  confirmations Json?
  reviewNotes   String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningRecord PlanningRecord          @relation(fields: [planningRecordId], references: [id], onDelete: Cascade)
  comments       PlanningReviewComment[]

  @@index([tenantId])
  @@index([planningRecordId])
  @@index([revisionNumber])
  @@index([reviewerId])
  @@index([status])
  @@index([startedAt])
}

model PlanningReviewComment {
  id       String @id @default(cuid())
  tenantId String

  planningRecordId String
  planningReviewId String?

  revisionNumber Int

  targetId String
  section  String
  label    String
  comment  String

  status String @default("Open")

  createdById   String?
  createdByName String?

  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningRecord PlanningRecord  @relation(fields: [planningRecordId], references: [id], onDelete: Cascade)
  planningReview PlanningReview? @relation(fields: [planningReviewId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([planningRecordId])
  @@index([planningReviewId])
  @@index([revisionNumber])
  @@index([targetId])
  @@index([status])
  @@index([createdAt])
}

model PlanningSignature {
  id       String @id @default(cuid())
  tenantId String

  planningRecordId String
  revisionNumber   Int

  role        String
  signerId    String?
  signerName  String
  signerEmail String?

  isRequired Boolean @default(true)
  sortOrder  Int     @default(0)

  status        String @default("Pending")
  signatureType String @default("Drawn")

  signatureStorageProvider String?
  signatureStorageKey      String?
  signatureStorageUrl      String?

  signedAt DateTime?

  ipAddress  String?
  userAgent  String?
  deviceInfo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningRecord PlanningRecord @relation(fields: [planningRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([planningRecordId])
  @@index([revisionNumber])
  @@index([signerId])
  @@index([role])
  @@index([status])
  @@index([signedAt])
}

model PlanningEvent {
  id       String @id @default(cuid())
  tenantId String

  planningRecordId String
  eventType        String

  previousStatus String?
  newStatus      String?

  revisionNumber Int?

  actorId   String?
  actorName String?
  actorRole String?

  comment  String?
  metadata Json?

  createdAt DateTime @default(now())

  planningRecord PlanningRecord @relation(fields: [planningRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([planningRecordId])
  @@index([eventType])
  @@index([revisionNumber])
  @@index([actorId])
  @@index([createdAt])
}

model DailyWorkerSafetyEngagement {
  id       String @id @default(cuid())
  tenantId String

  planningRecordId String
  revisionNumber   Int

  engagementDate DateTime
  shift          String?

  foremanId   String?
  foremanName String

  workLocation   String?
  dailyRiskLevel String?

  emergencyActionPlanReviewed Boolean @default(false)
  emergencyNotes              String?

  changeStatus String @default("No Changes")

  foremanMorningAcknowledgedAt DateTime?

  endOfShiftIncidentsOrNearMisses Boolean?
  endOfShiftConditionsChanged     Boolean?
  endOfShiftLessonsLearned        String?
  endOfShiftNotes                 String?

  carryForwardStatus     String?
  ptpRevisionRecommended Boolean @default(false)

  foremanFinalSignatureStorageProvider String?
  foremanFinalSignatureStorageKey      String?
  foremanFinalSignatureStorageUrl      String?
  foremanFinalSignedAt                 DateTime?

  status String @default("Open")

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningRecord PlanningRecord @relation(fields: [planningRecordId], references: [id], onDelete: Cascade)

  tasks      DailyWorkerSafetyEngagementTask[]
  signatures DailyWorkerSafetyEngagementSignature[]
  mocRecords DailyWorkerSafetyEngagementMoc[]

  @@index([tenantId])
  @@index([planningRecordId])
  @@index([revisionNumber])
  @@index([engagementDate])
  @@index([status])
}

model DailyWorkerSafetyEngagementTask {
  id       String @id @default(cuid())
  tenantId String

  dailyWseId String
  sequence   Int

  taskDescription String
  hazards         String
  mitigations     String

  riskLevel      String?
  safetyCritical Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyWse DailyWorkerSafetyEngagement @relation(fields: [dailyWseId], references: [id], onDelete: Cascade)

  @@unique([dailyWseId, sequence])
  @@index([tenantId])
  @@index([dailyWseId])
  @@index([riskLevel])
  @@index([safetyCritical])
}

model DailyWorkerSafetyEngagementSignature {
  id       String @id @default(cuid())
  tenantId String

  dailyWseId String
  workerId   String?

  workerName  String
  workerEmail String?

  acknowledgementStatus String @default("Pending")
  signatureType         String @default("Drawn")

  signatureStorageProvider String?
  signatureStorageKey      String?
  signatureStorageUrl      String?

  signedAt DateTime?

  signedInAt  DateTime?
  signedOutAt DateTime?

  signOutInitials String?

  ipAddress  String?
  userAgent  String?
  deviceInfo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyWse DailyWorkerSafetyEngagement @relation(fields: [dailyWseId], references: [id], onDelete: Cascade)
  worker   Worker?                     @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([dailyWseId])
  @@index([workerId])
  @@index([acknowledgementStatus])
  @@index([signedAt])
}

model DailyWorkerSafetyEngagementMoc {
  id       String @id @default(cuid())
  tenantId String

  dailyWseId String

  affectedTaskId String?

  changeDescription String
  newHazards        String?
  newMitigations    String?

  revisedRiskLevel String?

  requiresPtpRevision Boolean @default(false)

  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyWse DailyWorkerSafetyEngagement @relation(fields: [dailyWseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dailyWseId])
  @@index([affectedTaskId])
  @@index([requiresPtpRevision])
  @@index([createdAt])
}
