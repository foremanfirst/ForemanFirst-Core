"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { useParams } from "next/navigation";

type FieldControl = {
  id: string;
  workStepId: string;
  hazardId: string;
  controlId: string;
  controlText: string;
  controlHierarchy: string | null;
  protectiveFunction: string | null;
  effectiveness: string | null;
  verificationRequiredForCurrentContext: boolean | null;
  verificationEvidenceMethod: string | null;
  verificationEvidence: string | null;
  verificationCompleted: boolean;
  verifiedByName: string | null;
  verifiedByRole: string | null;
  verifiedAt: string | null;
  riskCreditEligible: boolean;
  criticalControlRecommended: boolean;
  criticalControlClassification: string;
  criticalControlDecision: string | null;
  criticalControlDecisionReason: string | null;
};

type FieldHazard = {
  hazardId: string;
  hazardText: string;
  canonicalHazardConceptId: string | null;
  controls: FieldControl[];
};

type FieldWorkStep = {
  id: string;
  sequence: number;
  title: string;
  description: string | null;
  equipmentTools: string | null;
  materialsChemicals: string | null;
  locationOverride: string | null;
  safetyCritical: boolean;
  inherentRiskLevel: string | null;
  recommendedControlledRiskLevel: string | null;
  controlledRiskLevel: string | null;
  fieldSummary: {
    hazardCount: number;
    controlCount: number;
    confirmedCriticalControlCount: number;
    controlsAwaitingVerification: number;
    completedVerifications: number;
  };
  hazards: FieldHazard[];
};

type FieldViewResponse = {
  fieldLifecycleState:
    | "Effective"
    | "Upcoming"
    | "Expired"
    | "Unavailable";
  fieldUseAllowed: boolean;
  record: {
    id: string;
    planType: string;
    title: string;
    status: string;
    revisionNumber: number;
    responsibleSupervisor: string | null;
    plannedStartDate: string | null;
    effectiveStartDate: string | null;
    effectiveEndDate: string | null;
    workLocation: string | null;
    crewSize: number | null;
    shift: string | null;
    scopeDescription: string | null;
    equipmentTools: string | null;
    materialsChemicals: string | null;
    adjacentWork: string | null;
    specialConditions: string | null;
    requiredPpe: string | null;
    requiredPermits: string | null;
    emergencyPlan: string | null;
    stopWorkTriggers: string | null;
    company: {
      id: string;
      name: string;
    };
    project: {
      id: string;
      name: string;
      projectCode: string | null;
      clientName: string | null;
    };
    contractor: {
      id: string;
      name: string;
      legalName: string | null;
      trade: string | null;
    } | null;
    workSteps: FieldWorkStep[];
  };
};

function formatFieldDate(value: string | null) {
  if (!value) {
    return "Not set";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
}

function fieldLifecycleMessage(
  state: FieldViewResponse["fieldLifecycleState"],
) {
  switch (state) {
    case "Effective":
      return "This approved PTP is currently effective for field use.";
    case "Upcoming":
      return "This approved PTP is not yet effective. Review only until the effective period begins.";
    case "Expired":
      return "This PTP has expired and is available for historical reference only.";
    default:
      return "This PTP is not available for field use.";
  }
}

export default function PlanningFieldViewPage() {
  const params = useParams<{
    planningRecordId: string;
  }>();

  const planningRecordId =
    params.planningRecordId;

  const [data, setData] =
    useState<FieldViewResponse | null>(
      null,
    );

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState<string | null>(null);

  useEffect(() => {
    let cancelled = false;

    async function loadFieldView() {
      setLoading(true);
      setError(null);

      try {
        const response =
          await fetch(
            `/api/planning/${planningRecordId}/field-view`,
            {
              cache: "no-store",
            },
          );

        const payload =
          await response.json();

        if (!response.ok) {
          throw new Error(
            payload.message ||
              "Unable to load field view.",
          );
        }

        if (!cancelled) {
          setData(
            payload as FieldViewResponse,
          );
        }
      } catch (loadError) {
        if (!cancelled) {
          setError(
            loadError instanceof Error
              ? loadError.message
              : "Unable to load field view.",
          );
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    }

    void loadFieldView();

    return () => {
      cancelled = true;
    };
  }, [planningRecordId]);

  if (loading) {
    return (
      <div className="p-6 text-sm font-bold text-[var(--qoreva-muted)]">
        Loading controlled PTP…
      </div>
    );
  }

  if (error || !data) {
    return (
      <div className="space-y-4 p-6">
        <Link
          href={`/planning/${planningRecordId}`}
          className="text-xs font-black text-[var(--qoreva-violet)]"
        >
          ← Planning Record
        </Link>

        <p className="text-sm font-bold text-red-700">
          {error ||
            "Unable to load field view."}
        </p>
      </div>
    );
  }

  const lifecycleStyles =
    data.fieldLifecycleState === "Effective"
      ? "border-[#BDE8D4] bg-[var(--qoreva-success-soft)] text-[var(--qoreva-success)]"
      : data.fieldLifecycleState === "Upcoming"
        ? "border-[var(--qoreva-border)] bg-[var(--qoreva-violet-soft)] text-[var(--qoreva-violet-dark)]"
        : "border-[var(--qoreva-border)] bg-[var(--qoreva-surface-muted)] text-[var(--qoreva-muted)]";

  return (
    <main className="mx-auto w-full max-w-5xl space-y-4 p-4 sm:p-6">
      <div className="flex items-center justify-between gap-3">
        <Link
          href={`/planning/${planningRecordId}`}
          className="text-xs font-black text-[var(--qoreva-violet)]"
        >
          ← Planning Record
        </Link>

        <span className="rounded-full bg-[var(--qoreva-violet-soft)] px-3 py-1 text-xs font-black text-[var(--qoreva-violet-dark)]">
          Controlled PTP
        </span>
      </div>

      <section className="rounded-[1.75rem] border border-[var(--qoreva-border)] bg-white p-5 shadow-[var(--qoreva-shadow-sm)] sm:p-6">
        <div className="space-y-5">
          <div className="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div className="min-w-0">
              <p className="text-xs font-black uppercase tracking-[0.16em] text-[var(--qoreva-violet)]">
                Approved Field Plan
              </p>

              <h1 className="mt-2 text-2xl font-black tracking-tight text-[var(--qoreva-obsidian)] sm:text-3xl">
                {data.record.title}
              </h1>

              <p className="mt-2 text-sm font-bold text-[var(--qoreva-muted)]">
                Revision {data.record.revisionNumber}
              </p>
            </div>

            <span className="w-fit rounded-full bg-[var(--qoreva-surface-muted)] px-3 py-1.5 text-xs font-black text-[var(--qoreva-obsidian)]">
              {data.record.status}
            </span>
          </div>

          <div
            className={`rounded-2xl border p-4 ${lifecycleStyles}`}
          >
            <div className="flex flex-wrap items-center gap-2">
              <span className="text-sm font-black">
                {data.fieldLifecycleState}
              </span>

              {data.fieldUseAllowed ? (
                <span className="rounded-full bg-white/70 px-2.5 py-1 text-[11px] font-black">
                  Field Use Active
                </span>
              ) : null}
            </div>

            <p className="mt-2 text-sm font-bold leading-6">
              {fieldLifecycleMessage(data.fieldLifecycleState)}
            </p>

            <p className="mt-2 text-xs font-bold opacity-80">
              Effective {formatFieldDate(data.record.effectiveStartDate)} –{" "}
              {formatFieldDate(data.record.effectiveEndDate)}
            </p>
          </div>

          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <div className="rounded-2xl bg-[var(--qoreva-surface-muted)] p-4">
              <p className="text-xs font-black uppercase tracking-wide text-[var(--qoreva-muted)]">
                Project
              </p>
              <p className="mt-1 text-sm font-black text-[var(--qoreva-obsidian)]">
                {data.record.project.name}
              </p>
            </div>

            <div className="rounded-2xl bg-[var(--qoreva-surface-muted)] p-4">
              <p className="text-xs font-black uppercase tracking-wide text-[var(--qoreva-muted)]">
                Contractor
              </p>
              <p className="mt-1 text-sm font-black text-[var(--qoreva-obsidian)]">
                {data.record.contractor?.name || "Not assigned"}
              </p>
            </div>

            <div className="rounded-2xl bg-[var(--qoreva-surface-muted)] p-4">
              <p className="text-xs font-black uppercase tracking-wide text-[var(--qoreva-muted)]">
                Location
              </p>
              <p className="mt-1 text-sm font-black text-[var(--qoreva-obsidian)]">
                {data.record.workLocation || "Not set"}
              </p>
            </div>

            <div className="rounded-2xl bg-[var(--qoreva-surface-muted)] p-4">
              <p className="text-xs font-black uppercase tracking-wide text-[var(--qoreva-muted)]">
                Responsible Supervisor
              </p>
              <p className="mt-1 text-sm font-black text-[var(--qoreva-obsidian)]">
                {data.record.responsibleSupervisor || "Not assigned"}
              </p>
            </div>

            <div className="rounded-2xl bg-[var(--qoreva-surface-muted)] p-4">
              <p className="text-xs font-black uppercase tracking-wide text-[var(--qoreva-muted)]">
                Crew
              </p>
              <p className="mt-1 text-sm font-black text-[var(--qoreva-obsidian)]">
                {data.record.crewSize ?? "Not set"}
              </p>
            </div>

            <div className="rounded-2xl bg-[var(--qoreva-surface-muted)] p-4">
              <p className="text-xs font-black uppercase tracking-wide text-[var(--qoreva-muted)]">
                Shift
              </p>
              <p className="mt-1 text-sm font-black text-[var(--qoreva-obsidian)]">
                {data.record.shift || "Not set"}
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>
  );
}
