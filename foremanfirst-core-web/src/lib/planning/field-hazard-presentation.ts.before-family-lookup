/**
 * Qoreva Field Hazard Presentation
 *
 * Builds a simplified field-facing view of canonical hazard intelligence
 * without mutating, merging, or deleting the underlying hazard groups.
 *
 * The safety model remains authoritative. This module only determines how
 * related concepts may be organized for field review.
 */

export type FieldPresentationRole =
  | "Primary"
  | "Detail"
  | "Umbrella"
  | "Independent";

export type FieldPresentationHazardGroup = {
  id: string;

  canonicalHazardConceptId?: string | null;

  canonicalHazardKind?:
    | "Hazard"
    | "Exposure"
    | "ReadinessCondition"
    | null;

  canonicalRiskAttention?:
    | "Normal"
    | "Elevated"
    | "HighAttention"
    | null;

  fieldPresentationFamily?: string | null;

  fieldPresentationRole?:
    | FieldPresentationRole
    | null;

  hazard: {
    id: string;
    text: string;
  };

  controls: unknown[];
};

export type FieldHazardPresentation<
  TGroup extends FieldPresentationHazardGroup =
    FieldPresentationHazardGroup,
> = {
  /**
   * Presentation identity only.
   *
   * This is not a canonical hazard identity and must not be used
   * as a replacement for member hazard IDs in risk, decision,
   * verification, requirement, or audit workflows.
   */
  id: string;

  primaryGroup: TGroup;

  /**
   * Original generated groups represented by this field conversation.
   * No groups are cloned, merged, or discarded here.
   */
  memberGroups: TGroup[];

  /**
   * Related canonical detail concepts that can be shown underneath
   * the primary field hazard instead of as separate top-level cards.
   */
  detailGroups: TGroup[];

  /**
   * True only when this presentation represents multiple underlying
   * canonical/generated hazard groups.
   */
  consolidated: boolean;

  /**
   * Field-facing summary values only.
   *
   * Underlying controls remain owned by their original hazard
   * groups and retain their individual identities.
   */
  totalControlCount: number;

  relatedDetailCount: number;
};

function presentationFamilyKey(
  group: FieldPresentationHazardGroup,
) {
  const family =
    group.fieldPresentationFamily?.trim();

  if (!family) {
    return null;
  }

  /*
   * Independent concepts deliberately remain their own field
   * conversations even when presentation-family metadata exists.
   */
  if (
    group.fieldPresentationRole ===
    "Independent"
  ) {
    return null;
  }

  return family;
}

export function buildFieldHazardPresentations<
  TGroup extends FieldPresentationHazardGroup,
>(
  groups: readonly TGroup[],
): FieldHazardPresentation<TGroup>[] {
  const consumedGroupIds =
    new Set<string>();

  const presentations:
    FieldHazardPresentation<TGroup>[] =
    [];

  for (const group of groups) {
    if (consumedGroupIds.has(group.id)) {
      continue;
    }

    const familyKey =
      presentationFamilyKey(group);

    /*
     * No family relationship means the canonical/generated hazard
     * remains an independent field conversation.
     */
    if (!familyKey) {
      presentations.push({
        id: `hazard:${group.id}`,
        primaryGroup: group,
        memberGroups: [group],
        detailGroups: [],
        consolidated: false,
        totalControlCount:
          group.controls.length,
        relatedDetailCount: 0,
      });

      consumedGroupIds.add(group.id);

      continue;
    }

    const familyMembers =
      groups.filter(
        (candidate) =>
          !consumedGroupIds.has(candidate.id) &&
          presentationFamilyKey(candidate) ===
            familyKey,
      );

    /*
     * Consolidation requires an explicit Primary concept.
     *
     * If a Detail concept exists without its Primary, preserve the
     * detail as its own visible hazard rather than guessing which
     * hazard should represent it.
     */
    const primaryGroup =
      familyMembers.find(
        (candidate) =>
          candidate.fieldPresentationRole ===
          "Primary",
      );

    if (!primaryGroup) {
      presentations.push({
        id: `hazard:${group.id}`,
        primaryGroup: group,
        memberGroups: [group],
        detailGroups: [],
        consolidated: false,
        totalControlCount:
          group.controls.length,
        relatedDetailCount: 0,
      });

      consumedGroupIds.add(group.id);

      continue;
    }

    const detailGroups =
      familyMembers.filter(
        (candidate) =>
          candidate.id !== primaryGroup.id &&
          candidate.fieldPresentationRole ===
            "Detail",
      );

    const representedGroups = [
      primaryGroup,
      ...detailGroups,
    ];

    /*
     * Any unexpected role remains outside this presentation.
     * This intentionally avoids silently swallowing future
     * metadata types or malformed relationships.
     */
    for (const represented of representedGroups) {
      consumedGroupIds.add(
        represented.id,
      );
    }

    presentations.push({
      id: `family:${familyKey}`,
      primaryGroup,
      memberGroups: representedGroups,
      detailGroups,
      consolidated:
        representedGroups.length > 1,

      totalControlCount:
        representedGroups.reduce(
          (total, member) =>
            total + member.controls.length,
          0,
        ),

      relatedDetailCount:
        detailGroups.length,
    });
  }

  return presentations;
}

/**
 * Returns the original hazard groups in field-presentation order.
 *
 * This helper is intentionally lossless: every underlying group represented
 * by the presentation model is returned using its original object identity.
 *
 * It is useful while migrating Step 5 from canonical-card rendering toward
 * field-conversation rendering without changing safety behavior.
 */
export function flattenFieldHazardPresentationGroups<
  TGroup extends FieldPresentationHazardGroup,
>(
  presentations: readonly FieldHazardPresentation<TGroup>[],
): TGroup[] {
  return presentations.flatMap(
    (presentation) =>
      presentation.memberGroups,
  );
}
